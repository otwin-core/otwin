# Otwin chart style (light theme). See DESIGN.md.
# Series colours, in order: model (violet), data (dark grey), warn, alarm.
# The measured series is drawn explicitly as ink dots: color #1d1d1f, no line.

figure.facecolor: ffffff
figure.dpi: 160
savefig.facecolor: ffffff
savefig.dpi: 160

axes.facecolor: ffffff
axes.edgecolor: 86868b
axes.linewidth: 1.0
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
axes.titlelocation: left
axes.titlesize: 13
axes.titleweight: bold
axes.titlecolor: 1d1d1f
axes.labelsize: 10
axes.labelcolor: 6e6e73
axes.prop_cycle: cycler('color', ['7a2ffc', '52525b', 'b45309', 'b8102e'])

grid.color: d2d2d7
grid.linewidth: 0.8

lines.linewidth: 2.0
lines.solid_capstyle: round

font.family: sans-serif
font.sans-serif: Helvetica Neue, Helvetica, Liberation Sans, Arial, DejaVu Sans
text.color: 1d1d1f

xtick.color: 6e6e73
ytick.color: 6e6e73
xtick.labelsize: 9
ytick.labelsize: 9
xtick.direction: out
ytick.direction: out

legend.frameon: False
legend.fontsize: 9
