+version: 2
+
+build:
+  os: ubuntu-24.04
+  tools:
+    python: "3.12"
+
+sphinx:
+  configuration: docs/conf.py
+  # Warnings are errors. A broken cross-reference renders as plain text and
+  # nobody notices for six months.
+  fail_on_warning: true
+
+python:
+  install:
+    - requirements: docs/requirements.txt
+    - method: pip
+      path: .
+      extra_requirements:
+        - gp
+
+formats:
+  - pdf
+  - htmlzip
